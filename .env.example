# Pull real values from your provider or copy them from Vercel/Supabase.

NEXT_PUBLIC_SUPABASE_URL="https://zoocimkwlrtuitktwiad.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_1wKmGvBwCrEDYA8mlthTDw_36VmmIQV"

# Drizzle can use DATABASE_URL directly, or POSTGRES_URL from the Supabase/Vercel integration.
DATABASE_URL="postgresql://postgres.zoocimkwlrtuitktwiad:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres"

# Production OTP defaults to database persistence and SMTP delivery.
# Development defaults to process-local persistence and emulated delivery.
# These optional overrides are useful for database-backed integration testing.
# OTP_STORE_MODE="database"
# OTP_DELIVERY_MODE="emulated"
# Generate a random secret with at least 32 characters. Never expose it to the browser.
OTP_HASH_SECRET="[RANDOM-SERVER-ONLY-SECRET]"
# Use a different random secret from OTP_HASH_SECRET.
VERIFICATION_SESSION_HASH_SECRET="[RANDOM-SERVER-ONLY-SECRET]"
# VERIFICATION_SESSION_STORE_MODE="database"

# SMTP provider settings. These example connection values use Purelymail.
SMTP_HOST="smtp.purelymail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="access@example.com"
SMTP_PASSWORD="[ACCOUNT-OR-APP-PASSWORD]"
# Must be authorized by the SMTP provider. Defaults to SMTP_USER.
OTP_EMAIL_FROM="Omnibudget <access@example.com>"
